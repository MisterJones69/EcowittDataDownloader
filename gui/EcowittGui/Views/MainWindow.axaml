<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EcowittGui.ViewModels"
        xmlns:views="using:EcowittGui.Views"
        x:Class="EcowittGui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ecowitt Data Downloader"
        Width="1400" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
  <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0">
    <TabItem Header="Downloader">
      <views:RunnerView DataContext="{Binding Runner}" />
    </TabItem>
    <TabItem Header="SD-Karte (download)">
      <views:SdDataView DataContext="{Binding SdData}" />
    </TabItem>
    <!-- "__" renders a literal underscore (a single one marks an access key) -->
    <TabItem Header="REST-API (download__rest)">
      <views:RestDataView DataContext="{Binding RestData}" />
    </TabItem>
  </TabControl>
</Window>
